# Server Port (Render sets process.env.PORT automatically)
PORT=5000

# Database URL (MySQL 8 - Local / Railway)
DATABASE_URL="mysql://root:Kimani@localhost:3306/misinformation_dashboard"

# JWT Authentication Secret Key
JWT_SECRET=replace_with_a_secure_256bit_secret_key_in_production

# Node Environment (development | production)
NODE_ENV=development

# Allowed CORS Origins (comma-separated for Netlify & Custom domains)
CORS_ORIGIN="https://your-app.netlify.app,https://your-custom-domain.com"

# API Version Tag
API_VERSION=1.0.0-rc1
