# =====================================================================
# Misinformation Research Intelligence API — Environment Variables
# =====================================================================

# 1. SERVER CONFIGURATION
# Render, Railway, & Fly.io automatically override PORT in cloud environments.
PORT=5000

# 2. DATABASE CONFIGURATION
# Railway automatically exposes MYSQL_URL. The backend automatically maps
# MYSQL_URL to DATABASE_URL if DATABASE_URL is omitted.
DATABASE_URL="mysql://root:password@localhost:3306/misinformation_dashboard"
# MYSQL_URL="mysql://root:password@localhost:3306/misinformation_dashboard"

# 3. SECURITY & AUTHENTICATION
# Production deployments MUST use a cryptographically strong random secret key.
# Generate via: `openssl rand -base64 32`
JWT_SECRET=production_secret_change_me_in_railway_or_render_settings

# 4. ENVIRONMENT CONTROL
# Mode: 'development' | 'production' | 'test'
NODE_ENV=development

# 5. CROSS-ORIGIN RESOURCE SHARING (CORS)
# Comma-separated list of allowed web frontend domains (e.g. Netlify/Custom Domains).
CORS_ORIGIN="https://your-app.netlify.app,https://your-custom-domain.com"

# 6. VERSIONING
API_VERSION=1.0.0-rc1
