{
  "openapi": "3.0.3",
  "info": {
    "title": "Misinformation Diffusion Dashboard & SNA Platform API",
    "description": "Production RESTful API for Social Network Analysis, misinformation tracking, dataset management, and automated report generation.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:5000/api",
      "description": "Local Development Server"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 1 },
          "name": { "type": "string", "example": "Dr. Jane Doe" },
          "email": { "type": "string", "example": "jane.doe@university.edu" },
          "role": { "type": "string", "example": "Analyst" }
        }
      },
      "Dataset": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 12 },
          "filename": { "type": "string", "example": "twitter_misinfo_batch.csv" },
          "uploadDate": { "type": "string", "format": "date-time" },
          "status": { "type": "string", "example": "Uploaded" },
          "uploadedById": { "type": "integer", "example": 1 }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": false },
          "message": { "type": "string", "example": "Validation or authentication error message" }
        }
      }
    }
  },
  "paths": {
    "/auth/register": {
      "post": {
        "summary": "Register a new user",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "email", "password"],
                "properties": {
                  "name": { "type": "string", "example": "Dr. Jane Doe" },
                  "email": { "type": "string", "example": "jane.doe@university.edu" },
                  "password": { "type": "string", "example": "SecurePass123!" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User registered successfully",
            "content": {
              "application/json": {
                "example": {
                  "message": "User registered successfully.",
                  "user": { "id": 1, "name": "Dr. Jane Doe", "email": "jane.doe@university.edu", "role": "Analyst" }
                }
              }
            }
          },
          "400": { "description": "Validation error" },
          "409": { "description": "Email already registered" }
        }
      }
    },
    "/auth/login": {
      "post": {
        "summary": "Authenticate user and issue JWT token",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "email": { "type": "string", "example": "jane.doe@university.edu" },
                  "password": { "type": "string", "example": "SecurePass123!" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful",
            "content": {
              "application/json": {
                "example": {
                  "message": "Login successful.",
                  "token": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...",
                  "user": { "id": 1, "name": "Dr. Jane Doe", "email": "jane.doe@university.edu", "role": "Analyst" }
                }
              }
            }
          },
          "401": { "description": "Invalid credentials" }
        }
      }
    },
    "/datasets": {
      "get": {
        "summary": "List datasets with optional search query",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "search", "in": "query", "schema": { "type": "string" }, "description": "Filter by filename" }
        ],
        "responses": {
          "200": { "description": "List of datasets retrieved" },
          "401": { "description": "Unauthorized" }
        }
      },
      "post": {
        "summary": "Create dataset record manually",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["filename"],
                "properties": {
                  "filename": { "type": "string", "example": "sample_dataset.csv" },
                  "status": { "type": "string", "example": "Uploaded" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Dataset created" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/datasets/upload": {
      "post": {
        "summary": "Upload CSV dataset and perform batch import",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": { "type": "string", "format": "binary" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "CSV dataset uploaded and imported successfully",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "message": "Dataset uploaded successfully.",
                  "dataset": { "id": 5, "filename": "twitter_dataset.csv", "status": "Uploaded" },
                  "recordsImported": 100,
                  "summary": { "totalRows": 100, "imported": 100, "skipped": 0 }
                }
              }
            }
          },
          "400": { "description": "CSV file required or invalid file format" }
        }
      }
    },
    "/datasets/{id}": {
      "get": {
        "summary": "Get single dataset details and associated posts",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": {
          "200": { "description": "Dataset details" },
          "404": { "description": "Dataset not found" }
        }
      },
      "delete": {
        "summary": "Delete dataset and cascade delete all related records",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": {
          "200": { "description": "Dataset deleted successfully" },
          "404": { "description": "Dataset not found" }
        }
      }
    },
    "/analysis/dashboard": {
      "get": {
        "summary": "Get dashboard system summary statistics",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "datasetId", "in": "query", "schema": { "type": "integer" } }],
        "responses": {
          "200": {
            "description": "Dashboard statistics",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "data": {
                    "totalUsers": 12,
                    "totalDatasets": 5,
                    "totalPosts": 450,
                    "totalHashtags": 84,
                    "totalReports": 5,
                    "misinformationPosts": 62
                  }
                }
              }
            }
          }
        }
      }
    },
    "/analysis/network": {
      "get": {
        "summary": "Get Social Network Analysis (SNA) nodes, edges, density, and degree centrality",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "datasetId", "in": "query", "schema": { "type": "integer" } }],
        "responses": {
          "200": {
            "description": "SNA Graph dataset",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "data": {
                    "totalNodes": 25,
                    "totalEdges": 48,
                    "density": 0.08,
                    "nodes": [{ "id": "@userA", "inDegree": 5, "outDegree": 3, "degree": 8, "degreeCentrality": 0.33 }],
                    "edges": [{ "source": "@userA", "target": "@userB", "type": "retweet" }]
                  }
                }
              }
            }
          }
        }
      }
    },
    "/analysis/centrality": {
      "get": {
        "summary": "Get ranked user degree centrality metrics",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "datasetId", "in": "query", "schema": { "type": "integer" } }],
        "responses": { "200": { "description": "Ranked centrality metrics" } }
      }
    },
    "/analysis/influencers": {
      "get": {
        "summary": "Get top network influencer users by interaction count",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "datasetId", "in": "query", "schema": { "type": "integer" } }],
        "responses": { "200": { "description": "Top influencers list" } }
      }
    },
    "/analysis/hashtags": {
      "get": {
        "summary": "Get top trending hashtags by frequency",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "datasetId", "in": "query", "schema": { "type": "integer" } }],
        "responses": { "200": { "description": "Top hashtags list" } }
      }
    },
    "/analysis/timeline": {
      "get": {
        "summary": "Get daily post volume and misinformation diffusion timeline",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "datasetId", "in": "query", "schema": { "type": "integer" } }],
        "responses": { "200": { "description": "Timeline data" } }
      }
    },
    "/reports": {
      "get": {
        "summary": "Get list of generated analysis reports",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "List of reports" } }
      }
    },
    "/reports/pdf/{datasetId}": {
      "get": {
        "summary": "Generate and download automated PDF report for a dataset",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "datasetId", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": {
          "200": {
            "description": "PDF Document Stream",
            "content": { "application/pdf": {} }
          }
        }
      }
    },
    "/reports/csv/{datasetId}": {
      "get": {
        "summary": "Export dataset posts and hashtags as CSV attachment",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "datasetId", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": {
          "200": {
            "description": "CSV File Stream",
            "content": { "text/csv": {} }
          }
        }
      }
    }
  }
}
